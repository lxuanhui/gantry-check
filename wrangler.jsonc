{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gantry-check",
	"main": "src/entry.py",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["python_workers"],
	"observability": { "enabled": true },
	// The prerendered SvelteKit UI (web/). `not_found_handling` is deliberately left at its
	// default so any path without a matching asset falls through to the Python Worker — that
	// is what keeps /estimate, /gantries and /docs working. `/` is served by index.html,
	// shadowing FastAPI's own landing route.
	"assets": { "directory": "./web/build" },
	"vars": {
		"ROUTING_ENGINE": "google"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gantry-check",
			"database_id": "d4002cd9-d5fc-45e1-adf1-7cf0c619f829",
			"migrations_dir": "migrations"
		}
	]
}
