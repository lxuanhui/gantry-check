{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gantry-check",
	"main": "src/entry.py",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["python_workers"],
	"observability": { "enabled": true },
	// The prerendered SvelteKit UI (web/). `not_found_handling` is deliberately left at its
	// default so any path without a matching asset falls through to the Python Worker — that
	// is what keeps /estimate, /gantries and /docs working. `/` is served by index.html,
	// shadowing FastAPI's own landing route.
	"assets": { "directory": "./web/build" },
	"vars": {
		"ROUTING_ENGINE": "google",
		// Country codes (comma-separated) allowed to POST /estimate, matched against the
		// `cf-ipcountry` header Cloudflare sets. Empty or absent = no country gate.
		"ALLOWED_COUNTRIES": "SG"
	},
	// Per-IP rate limit for POST /estimate (each call there costs a routing-provider request).
	// `period` must be 10 or 60; `namespace_id` is an arbitrary integer naming this
	// limit's counter namespace.
	"ratelimits": [
		{
			"name": "ESTIMATE_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gantry-check",
			"database_id": "d4002cd9-d5fc-45e1-adf1-7cf0c619f829",
			"migrations_dir": "migrations"
		}
	]
}
